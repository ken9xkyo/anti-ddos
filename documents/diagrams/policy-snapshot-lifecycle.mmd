flowchart LR
    inputs["Tenant-scoped policy inputs<br/>services, rules, lists, feeds, UDP ports"]
    build["BuildPolicySnapshot"]
    sign["Canonical checksum + object checksum"]
    db[("policy_snapshots")]
    agentFetch["Agent fetches newer version"]
    validate["Verify schema, checksum, capacity, object"]
    resolve["Resolve forwarding metadata"]
    inactive["Populate inactive A/B maps"]
    devmap["Update tx_devmap"]
    flip["Flip runtime_config.active_slot"]
    persist["Persist last-valid snapshot"]
    ack["Record apply status"]

    inputs --> build
    build --> sign
    sign --> db
    db --> agentFetch
    agentFetch --> validate
    validate --> resolve
    resolve --> inactive
    inactive --> devmap
    devmap --> flip
    flip --> persist
    persist --> ack
    validate -. "fail: keep previous active slot" .-> ack
    inactive -. "fail: clear inactive slot" .-> ack
    devmap -. "fail: rollback touched entries" .-> ack
