flowchart TD
    packet([WAN packet])
    runtime{runtime_config valid?}
    parse{Parse VLAN IPv4 L4}
    pass[Pass non IPv4]
    malformed[Drop malformed or fragment]
    service{Service allowlist hit?}
    serviceDrop[Drop not allowed service]
    whitelist{Global or service whitelist?}
    threat{Blacklist or UDP source port?}
    threatDrop[Drop threat match]
    neighbor{Neighbor resolved?}
    neighborDrop[Drop unresolved neighbor]
    rule{Default rule over limit or drop?}
    ruleDrop[Drop rule or rate limit]
    redirect[Rewrite MAC and XDP_REDIRECT]

    packet --> runtime
    runtime -- No --> serviceDrop
    runtime -- Yes --> parse
    parse -- Non IPv4 --> pass
    parse -- Bad IPv4 or fragment --> malformed
    parse -- Valid IPv4 --> service
    service -- No --> serviceDrop
    service -- Yes --> whitelist
    whitelist -- Yes --> neighbor
    whitelist -- No --> threat
    threat -- Yes --> threatDrop
    threat -- No --> neighbor
    neighbor -- No --> neighborDrop
    neighbor -- Yes --> rule
    rule -- Yes --> ruleDrop
    rule -- No --> redirect
