erDiagram
    APP_USERS ||--o{ USER_SESSIONS : owns
    APP_USERS ||--o{ AGENTS : owns
    APP_USERS ||--o{ BACKEND_SERVICES : owns
    APP_USERS ||--o{ RULES : owns
    APP_USERS ||--o{ WHITELIST_ENTRIES : owns
    APP_USERS ||--o{ MANUAL_BLACKLIST_ENTRIES : owns
    APP_USERS ||--o{ UDP_SOURCE_PORT_BLOCKS : owns
    APP_USERS ||--o{ POLICY_SNAPSHOTS : owns
    APP_USERS ||--o{ SECURITY_EVENTS : owns
    APP_USERS ||--o{ TELEGRAM_CONFIGS : owns
    APP_USERS ||--o{ ALERTS : owns
    APP_USERS ||--o{ AUDIT_EVENTS : owns

    APP_USERS {
        uuid id PK
        text username UK
        text role "admin|user"
        text status
        boolean force_password_change
    }
    USER_SESSIONS {
        uuid id PK
        uuid user_id FK
        uuid view_owner_user_id FK
        text token_hash
        timestamptz expires_at
    }
    BACKEND_SERVICES {
        uuid id PK
        uuid owner_user_id FK
        text name
        inet backend_cidr
    }
    RULES {
        uuid id PK
        uuid owner_user_id FK
        uuid service_id FK
        text action
    }
    POLICY_SNAPSHOTS {
        uuid owner_user_id PK
        int version PK
        jsonb snapshot
    }
    AGENTS {
        uuid id PK
        uuid owner_user_id FK
        text hostname
    }
