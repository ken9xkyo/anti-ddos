flowchart TB
    subgraph host["Scrubbing host"]
        wan["WAN NIC"]
        output["Output NIC"]
        xdp["xdp_entry<br/>bpf/xdp_data_plane.bpf.c"]
        maps[("Pinned eBPF maps")]
        agent["anti-ddos-agent<br/>cmd/agent"]
        snapshot["last-valid snapshot"]
    end

    subgraph management["Management stack"]
        api["control-api<br/>cmd/control-api"]
        admin["control-admin<br/>cmd/control-admin"]
        ui["Admin Dashboard<br/>React/Vite"]
        db[("PostgreSQL")]
        prom["Prometheus"]
        graf["Grafana"]
    end

    wan --> xdp
    xdp <--> maps
    xdp -->|"XDP_REDIRECT through tx_devmap"| output
    agent -->|"load/attach/pin"| xdp
    agent -->|"apply policy A/B slot"| maps
    agent -->|"persist"| snapshot
    agent -->|"metrics + sampled events"| prom
    agent -->|"agent API sync"| api
    ui -->|"JSON /v1"| api
    admin -->|"bootstrap first admin"| db
    api -->|"migrations + tenant data"| db
    api -->|"PromQL query/status"| prom
    prom --> graf
