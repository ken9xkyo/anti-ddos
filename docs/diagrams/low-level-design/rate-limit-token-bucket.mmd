flowchart TD
    packet([Packet reaches service rule])
    rateRule{ACTION_RATE_LIMIT?}
    key[Build rate_key]
    lookup{rate_state_v2 hit?}
    create[Create state or fail closed]
    lock[Spin lock state]
    refill[Refill PPS BPS CPS buckets]
    check{Any bucket over limit?}
    debit[Debit tokens and counters]
    unlock[Unlock state]
    enforce{Mode enforce?}
    drop[Drop REASON_RATE_LIMIT]
    observe[Observe or continue]

    packet --> rateRule
    rateRule -- No --> observe
    rateRule -- Yes --> key
    key --> lookup
    lookup -- No --> create
    lookup -- Yes --> lock
    create --> lock
    lock --> refill
    refill --> check
    check -- No --> debit
    debit --> unlock
    check -- Yes --> unlock
    unlock --> enforce
    enforce -- Yes and over limit --> drop
    enforce -- No or under limit --> observe
