flowchart TD
    packet([Packet vào WAN NIC])
    runtime{runtime_config hợp lệ?}
    parse{Parse Ethernet/IPv4/L4}
    pass[Pass non-IPv4]
    malformed[Drop malformed/fragment]
    service{Match service_allowlist?}
    serviceMiss[Drop not allowed service]
    whitelist{Whitelist match?}
    threat{Blacklist hoặc UDP source port?}
    threatDrop[Drop threat]
    neighbor{Forwarding resolved?}
    rule{Default rule action}
    ruleDrop[Drop theo rule/rate limit]
    redirect[Rewrite MAC + XDP_REDIRECT]

    packet --> runtime
    runtime -- Không --> serviceMiss
    runtime -- Có --> parse
    parse -- Non-IPv4 --> pass
    parse -- Lỗi hoặc fragment --> malformed
    parse -- IPv4 hợp lệ --> service
    service -- Không --> serviceMiss
    service -- Có --> whitelist
    whitelist -- Có --> neighbor
    whitelist -- Không --> threat
    threat -- Có --> threatDrop
    threat -- Không --> neighbor
    neighbor -- Không --> ruleDrop
    neighbor -- Có --> rule
    rule -- Drop/over limit --> ruleDrop
    rule -- Observe/sample/pass --> redirect
