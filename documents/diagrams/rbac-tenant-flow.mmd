flowchart TD
    login["POST /v1/auth/login"]
    session["user_sessions.active_tenant_id"]
    actor["Actor with role + platform_role"]
    platform{platform_admin?}
    tenantTx["beginContextTenantTx<br/>set anti_ddos.tenant_id"]
    platformTx["beginPlatformTx<br/>set anti_ddos.platform=true"]
    rls["PostgreSQL RLS tenant_isolation"]
    data["Tenant-scoped rows"]
    switch["POST /v1/tenants/switch"]
    membership["tenant_memberships"]

    login --> membership
    membership --> session
    session --> actor
    actor --> platform
    platform -->|no| tenantTx
    platform -->|yes for platform operations| platformTx
    actor --> switch
    switch --> session
    tenantTx --> rls
    platformTx --> rls
    rls --> data
