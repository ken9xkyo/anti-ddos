flowchart TD
    platformUser["Platform user"]
    platformRole["Platform role<br/>platform_owner<br/>platform_admin<br/>platform_support<br/>platform_auditor"]
    platformConsole["Platform console<br/>tenant lifecycle<br/>platform audit<br/>support grants"]
    supportGrant["Support grant<br/>tenant-specific<br/>reason-required<br/>TTL-bound"]

    tenantUser["Tenant user"]
    membership["TenantMembership<br/>tenant_owner<br/>tenant_admin<br/>security_operator<br/>network_operator<br/>viewer<br/>auditor"]
    activeTenant["Active tenant session<br/>Tenant = Customer Account"]
    effectiveRole["Effective tenant role"]

    auth["Auth /v1/auth/login<br/>/v1/me<br/>/v1/tenants/switch"]
    apiGuard{"Resource permission"}
    securityResources["Security resources<br/>rules, lists, feeds, snapshots, alerts"]
    networkResources["Network resources<br/>services, forwarding, agents"]
    readResources["Read resources<br/>dashboard, events, summaries"]
    auditResources["Tenant audit<br/>change history"]
    rls["Tenant transaction<br/>RLS tenant_id context"]
    platformTx["Platform transaction<br/>reason + audit required"]
    audit["AuditEvent<br/>actor, tenant, reason, before/after"]

    platformUser --> platformRole --> platformConsole
    platformConsole --> platformTx
    platformConsole --> supportGrant
    supportGrant --> activeTenant

    tenantUser --> auth --> activeTenant
    activeTenant --> membership --> effectiveRole --> apiGuard

    apiGuard -->|"security_operator / tenant_admin / tenant_owner"| securityResources
    apiGuard -->|"network_operator / tenant_admin / tenant_owner"| networkResources
    apiGuard -->|"all active tenant roles"| readResources
    apiGuard -->|"auditor / tenant_admin / tenant_owner"| auditResources

    securityResources --> rls
    networkResources --> rls
    readResources --> rls
    auditResources --> rls
    rls --> audit
    platformTx --> audit
